@using Otympics.Data;

<tr>
    <td>@User.Flag @User.Name</td>
    <td>
        <input type="number" @bind="User.Gold" style="width: 5rem;"/>
    </td>
    <td>
        <input type="number" @bind="User.Silver" style="width: 5rem;"/>
    </td>
    <td>
        <input type="number" @bind="User.Bronze" style="width: 5rem;"/>
    </td>
    <td>
        <input type="number" @bind="User.DNP" style="width: 5rem;"/>
    </td>
</tr>


@code {
    [Parameter]
    public User User { get; set; }
}
