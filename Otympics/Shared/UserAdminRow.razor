@using Otympics.Data;

<tr>
    <td>@User.Flag @User.Name</td>
    <td>
        <input type="number" @bind="User.Gold" style="height:3rem; font-size:3rem;width:5rem"/>
    </td>
    <td>
        <input type="number" @bind="User.Silver" style="height:3rem; font-size:3rem;width:5rem" />
    </td>
    <td>
        <input type="number" @bind="User.Bronze" style="height:3rem; font-size:3rem;width:5rem" />
    </td>
    <td>
        <input type="number" @bind="User.DNP" style="height:3rem; font-size:3rem;width:5rem" />
    </td>
</tr>


@code {
    [Parameter]
    public User User { get; set; }
}
