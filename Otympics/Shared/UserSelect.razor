<p>@AllSelected</p>
<select @bind="Selection" name="users" id="users">
  <option value="default">Select Player</option>
  <option value="Cannon">Cannon</option>
  <option value="Chris">Chris</option>
  <option value="Clayton">Clatyon</option>
  <option value="Jake">Jake</option>
  <option value="Jeff">Jeff</option>
  <option value="Johnny">Johnny</option>
  <option value="Josh">Josh</option>
  <option value="Pete">Pete</option>
  <option value="Mike">Mike</option>
  <option value="Tim">Tim</option>
  <option value="Will">Will</option>
</select>
<button name="addButton" @onclick="Add">Add</button>


@code{
    private string Selection;

    [Parameter]
    public HashSet<string> Selected{get;set;} = new();

    [Parameter]
    public EventCallback<HashSet<string>> SelectedChanged { get; set; }

    private string AllSelected;

    private async void Add(){
        Console.WriteLine(Selection);
        if(Selected == null){ Selected = new(); }
        Selected.Add(Selection);
        await SelectedChanged.InvokeAsync(Selected);
        AllSelected = string.Join(",", Selected);
        Selection = "default";
    }
}
