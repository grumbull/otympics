@page "/medals"
@page "/"
@using Otympics.Data
@inject OtympicsData MainData


<img id="biglogo" src="images/big-logo.png" alt="The correct spelling." class="">
<div class="page-header">
    <h1>Medal Count</h1>
</div>

@if (MainData == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th></th>
                <th>Name</th>
                <th>&#127942;</th>
                <th>&#129351;</th>
                <th>&#129352;</th>
                <th>&#129353;</th>
                <th>&#128169;</th>
                <th>&#9654;&#65039;</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < MainData.GetUsersByScore().Count; i++)
            {
                var user = MainData.GetUsersByScore()[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td>@user.Flag @user.Name</td>
                    <td><p style="font-weight:900">@user.TotalMedals</p></td>
                    <td>@user.Gold</td>
                    <td>@user.Silver</td>
                    <td>@user.Bronze</td>
                    <td>@user.DNP</td>
                    <td>@user.TotalEvents</td>
                </tr>
            }
        </tbody>
    </table>
}